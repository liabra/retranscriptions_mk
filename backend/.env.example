# ─── A2C Retranscriptions — variables d'environnement ────────────────────────
# Copier en .env pour le développement local. Ne JAMAIS commiter de .env réel.
# Détail de chaque service externe : docs/CONFIGURATION_SERVICES_EXTERNES.md

# Base de données PostgreSQL (Railway injecte DATABASE_URL automatiquement)
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/a2c_retranscriptions

# Sécurité — OBLIGATOIRES
# SECRET_KEY : python -c "import secrets; print(secrets.token_hex(32))"  (32 caractères minimum en production)
SECRET_KEY=
# ENCRYPTION_KEY : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Chiffre les IBAN et les liens OneDrive privés. NE JAMAIS LA CHANGER une fois des données enregistrées.
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application
APP_ENV=development            # development | test | production
DEBUG=false                    # true expose la documentation /docs (jamais en production)
ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173   # adresse de l'interface, utilisée dans les liens des emails

# Fichiers
MAX_AUDIO_MB=500
MAX_DOCX_MB=25
PV_STORAGE_BACKEND=database    # database (PostgreSQL) | onedrive
AUDIO_STORAGE_BACKEND=local    # onedrive en production ; local = développement uniquement
LOCAL_STORAGE_DIR=./stockage_local

# Microsoft Graph / OneDrive (facultatif tant que l'association n'a pas créé l'application Microsoft)
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_FOLDER=A2C Retranscriptions
ONEDRIVE_INBOX_FOLDER=A2C Retranscriptions/Nouveaux audios
GRAPH_SYNC_INTERVAL_MINUTES=0  # >0 active la détection automatique (nécessite ENABLE_SCHEDULER=true)

# Emails — Brevo (facultatif : sans clé, seules les notifications internes fonctionnent)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=A2C Retranscriptions

# Tâches périodiques : alertes d'échéance / de retard, détection OneDrive
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60

# Anti-bruteforce de la connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
